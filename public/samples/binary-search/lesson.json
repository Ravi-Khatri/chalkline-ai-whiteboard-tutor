  "quiz": [
    {
      "q": "What is the main idea behind binary search?",
      "options": [
        "To search the list from start to finish",
        "To divide the search interval in half repeatedly",
        "To search the list in reverse order",
        "To use a random search"
      ],
      "answer": 1,
      "why": "Binary search works by repeatedly dividing the search interval in half until the item is found."
    },
    {
      "q": "What happens when the target value is compared to the middle element in binary search?",
      "options": [
        "The search interval is adjusted to include the entire list",
        "The search interval is divided in half and the search continues in one of the halves",
        "The search is stopped and the item is declared not found",
        "The list is sorted again"
      ],
      "answer": 1,
      "why": "In binary search, when the target value is compared to the middle element, the search interval is adjusted to include either the lower or upper half of the list."
    },
    {
      "q": "What is the advantage of using binary search over a linear search?",
      "options": [
        "Binary search is slower than linear search",
        "Binary search is less efficient than linear search",
        "Binary search is more efficient than linear search for large lists",
        "Binary search only works for small lists"
      ],
      "answer": 2,
      "why": "Binary search is more efficient than linear search for large lists because it reduces the number of comparisons needed to find the target value."
    }
