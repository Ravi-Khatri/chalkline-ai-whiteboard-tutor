# Cloudflare Workers Static Assets headers (security hardening).
/*
  # No Referer to other sites. Privacy, and required for on-device mode:
  # Hugging Face answers 404 to model downloads referred from *.workers.dev.
  Referrer-Policy: no-referrer
  # Don't let the browser guess content types.
  X-Content-Type-Options: nosniff
  # Clickjacking protection: the app must not be framed by other sites.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  # The app never uses these device features (the pen uses pointer events only).
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
